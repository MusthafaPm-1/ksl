// ======================================================

app.put(
    "/api/admin/matches/:id",
    authenticateAdmin,
    async (req, res) => {

        try {

            const { id } = req.params;

            const {
                status,
                minute,
                home_score,
                away_score
            } = req.body;


            const [matches] = await db.query(
                "SELECT * FROM matches WHERE id = ?",
                [id]
            );


            if (matches.length === 0) {

                return res.status(404).json({
                    success: false,
                    message: "Match not found"
                });

            }


            const match = matches[0];


            const newStatus =
                status !== undefined
                    ? status
                    : match.status;

            const newMinute =
                minute !== undefined
                    ? Number(minute)
                    : match.minute;

            const newHomeScore =
                home_score !== undefined
                    ? Number(home_score)
                    : match.home_score;

            const newAwayScore =
                away_score !== undefined
                    ? Number(away_score)
                    : match.away_score;


            const allowedStatuses = [
                "scheduled",
                "live",
                "half-time",
                "finished",
                "postponed"
            ];


            if (!allowedStatuses.includes(newStatus)) {

                return res.status(400).json({
                    success: false,
                    message: "Invalid match status"
                });

            }


            if (
                Number.isNaN(newMinute) ||
                newMinute < 0
            ) {

                return res.status(400).json({
                    success: false,
                    message: "Invalid match minute"
                });

            }


            if (
                Number.isNaN(newHomeScore) ||
                Number.isNaN(newAwayScore) ||
                newHomeScore < 0 ||
                newAwayScore < 0
            ) {

                return res.status(400).json({
                    success: false,
                    message: "Invalid score"
                });

            }


            await db.query(
                `
                UPDATE matches
                SET
                    status = ?,
                    minute = ?,
                    home_score = ?,
                    away_score = ?
                WHERE id = ?
                `,
                [
                    newStatus,
                    newMinute,
                    newHomeScore,
                    newAwayScore,
                    id
                ]
            );


            // Broadcast update to connected viewers
            io.emit("matchUpdated", {
                matchId: Number(id),
                status: newStatus,
                minute: newMinute,
                home_score: newHomeScore,
                away_score: newAwayScore
            });


            res.json({
                success: true,
                message: "Match updated successfully"
            });


        } catch (error) {

            console.error(
                "Update match error:",
                error
            );

            res.status(500).json({
                success: false,
                message: "Database error"
            });

        }

    }
);

