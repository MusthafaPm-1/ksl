    async (req, res) => {

        try {

            const {
                username,
                password
            } = req.body;

            if (!username || !password) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Username and password are required"
                });

            }

            const [admins] =
                await db.query(
                    "SELECT * FROM admins WHERE username = ?",
                    [username]
                );

            if (admins.length === 0) {

                return res.status(401).json({
                    success: false,
                    message:
                        "Invalid username or password"
                });

            }

            const admin = admins[0];

            const passwordMatch =
                await bcrypt.compare(
                    password,
                    admin.password
                );

            if (!passwordMatch) {

                return res.status(401).json({
                    success: false,
                    message:
                        "Invalid username or password"
                });

            }

            const token =
                jwt.sign(
                    {
                        id: admin.id,
                        username:
                            admin.username
                    },
                    process.env.JWT_SECRET,
                    {
                        expiresIn: "1d"
                    }
                );

            res.json({

                success: true,

                message:
                    "Login successful",

                token,

                admin: {
                    id: admin.id,
                    username:
                        admin.username
                }

            });

        } catch (error) {

            console.error(
                "Admin login error:",
