                                disabled={
                                    adding
                                }
                            >

                                {adding
                                    ? "Adding..."
                                    : "Add Team"}

                            </button>

                        </form>

                    </div>

                )}

                {/* EDIT FORM */}

                {editingTeam && (

                    <div className="admin-form-card">

                        <h2>
