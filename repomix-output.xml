                                            "yellow_card"
                                        ) {
                                            icon = "🟨";
                                        }

                                        if (
                                            event.event_type ===
                                            "red_card"
                                        ) {
                                            icon = "🟥";
                                        }

                                        if (
                                            event.event_type ===
                                            "substitution"
                                        ) {
