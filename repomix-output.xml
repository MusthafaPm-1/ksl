// ------------------------------------------------------------
// ADD MATCH EVENT
// ------------------------------------------------------------

app.post(
    "/api/admin/matches/:id/events",
    authenticateAdmin,
    async (req, res) => {
        let connection;

        try {
            const { id } = req.params;

            const {
                team_id,
                player_name,
                event_type,
                minute
            } = req.body;


            // ----------------------------------------
            // VALIDATE EVENT TYPE
            // ----------------------------------------

            const allowedEventTypes = [
                "goal",
                "yellow_card",
                "red_card",
                "substitution"
            ];

            if (!allowedEventTypes.includes(event_type)) {
                return res.status(400).json({
                    success: false,
                    message: "Invalid event type"
                });
            }


            // ----------------------------------------
            // GET MATCH
            // ----------------------------------------

            const [matches] = await db.query(
                "SELECT * FROM matches WHERE id = ?",
                [id]
            );

            if (matches.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Match not found"
                });
            }

            const match = matches[0];


            // ----------------------------------------
            // VALIDATE TEAM
            // ----------------------------------------

            if (!team_id) {
                return res.status(400).json({
                    success: false,
                    message: "Team is required"
                });
            }

            const teamIdNumber = Number(team_id);

            if (
                teamIdNumber !==
                    Number(match.home_team_id) &&
                teamIdNumber !==
                    Number(match.away_team_id)
            ) {
                return res.status(400).json({
                    success: false,
                    message:
                        "Selected team is not part of this match"
                });
            }


            // ----------------------------------------
            // VALIDATE MINUTE
            // ----------------------------------------

            const eventMinute =
                minute !== undefined &&
                minute !== null &&
                minute !== ""
                    ? Number(minute)
                    : Number(match.minute || 0);

            if (
                Number.isNaN(eventMinute) ||
                eventMinute < 0
            ) {
                return res.status(400).json({
                    success: false,
                    message: "Invalid event minute"
                });
            }


            // ----------------------------------------
            // PLAYER NAME
            // ----------------------------------------

            const playerName =
                player_name &&
                String(player_name).trim()
                    ? String(player_name).trim()
                    : null;


            // ----------------------------------------
            // EVENT SHOULD ONLY BE CREATED DURING
            // LIVE MATCH
            // ----------------------------------------

            if (
                match.status !== "live" &&
                match.status !== "half-time"
            ) {
                return res.status(400).json({
                    success: false,
                    message:
                        "Match must be live to add events"
                });
            }


            // ----------------------------------------
            // DATABASE TRANSACTION
            // ----------------------------------------

            connection = await db.getConnection();

            await connection.beginTransaction();


            // ----------------------------------------
            // INSERT EVENT
            // ----------------------------------------

            const [eventResult] =
                await connection.query(
                    `
                    INSERT INTO match_events
                    (
                        match_id,
                        team_id,
                        player_name,
                        event_type,
                        minute
                    )
                    VALUES (?, ?, ?, ?, ?)
                    `,
                    [
                        id,
                        teamIdNumber,
                        playerName,
                        event_type,
                        eventMinute
                    ]
                );


            // ----------------------------------------
            // IF GOAL → UPDATE SCORE
            // ----------------------------------------

            let newHomeScore =
                Number(match.home_score || 0);

            let newAwayScore =
                Number(match.away_score || 0);


            if (event_type === "goal") {

                if (
                    teamIdNumber ===
                    Number(match.home_team_id)
                ) {
                    newHomeScore++;
                }

                if (
                    teamIdNumber ===
                    Number(match.away_team_id)
                ) {
                    newAwayScore++;
                }


                await connection.query(
                    `
                    UPDATE matches

                    SET
                        home_score = ?,
                        away_score = ?

                    WHERE id = ?
                    `,
                    [
                        newHomeScore,
                        newAwayScore,
                        id
                    ]
                );
            }


            await connection.commit();


            // ----------------------------------------
            // GET CREATED EVENT WITH TEAM INFO
            // ----------------------------------------

            const [createdEvents] =
                await db.query(
                    `
                    SELECT
                        me.id,
                        me.match_id,
                        me.team_id,
                        me.player_name,
                        me.event_type,
                        me.minute,
                        me.created_at,

                        t.name AS team_name,
                        t.logo AS team_logo

                    FROM match_events me

                    LEFT JOIN teams t
                        ON me.team_id = t.id

                    WHERE me.id = ?
                    `,
                    [eventResult.insertId]
                );


            const createdEvent =
                createdEvents[0];


            // ----------------------------------------
            // SOCKET.IO - EVENT
            // ----------------------------------------

            io.emit("matchEvent", {
                matchId: Number(id),
                event: createdEvent
            });


            // ----------------------------------------
            // SOCKET.IO - UPDATED SCORE
            // ----------------------------------------

            io.emit("matchUpdated", {
                matchId: Number(id),

                status: match.status,

                minute: Number(match.minute || 0),

                home_score: newHomeScore,

                away_score: newAwayScore
            });


            res.json({
                success: true,

                message:
                    "Match event added successfully",

                event: createdEvent,

                home_score: newHomeScore,

                away_score: newAwayScore
            });

        } catch (error) {

            if (connection) {
                try {
                    await connection.rollback();
                } catch (rollbackError) {
                    console.error(
                        "Rollback error:",
                        rollbackError
                    );
                }
            }

            console.error(
                "Add match event error:",
                error
            );

            res.status(500).json({
                success: false,
                message: "Database error"
            });

        } finally {

            if (connection) {
                connection.release();
            }
        }
    }
);

