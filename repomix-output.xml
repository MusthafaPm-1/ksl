                !Number.isInteger(
                    numericMinute
                ) ||
                numericMinute < 0 ||
                numericMinute > 130
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Minute must be a number between 0 and 130"
                });

            }

            const [matches] = await db.query(
                `SELECT *
