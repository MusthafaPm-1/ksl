/* =========================================================
   ADD MATCH EVENT
========================================================= */

app.post(
    "/api/admin/matches/:id/events",
    authenticateAdmin,
    async (req, res) => {

        let connection = null;


        try {

            const {
                id
            } = req.params;


            const {
                team_id,
                player_name,
                event_type,
                minute
            } = req.body;


            /* -----------------------------------------
               VALIDATE TEAM
            ----------------------------------------- */

            if (!team_id) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Team is required"
                });

            }


            /* -----------------------------------------
               VALIDATE PLAYER
            ----------------------------------------- */

            if (
                !player_name ||
                !player_name.trim()
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Player name is required"
                });

            }


            /* -----------------------------------------
               VALIDATE EVENT TYPE
            ----------------------------------------- */

            const allowedEventTypes = [
                "goal",
                "yellow_card",
                "red_card",
                "substitution"
            ];


            if (
                !allowedEventTypes.includes(
                    event_type
                )
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Invalid event type"
                });

            }


            /* -----------------------------------------
               VALIDATE MINUTE
            ----------------------------------------- */

            const eventMinute =
                Number(minute);


            if (
                Number.isNaN(eventMinute) ||
                eventMinute < 0 ||
                eventMinute > 130
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Minute must be between 0 and 130"
                });

            }


            /* -----------------------------------------
               GET MATCH
            ----------------------------------------- */

            const [matches] =
                await db.query(
                    `
                    SELECT
                        id,
                        home_team_id,
                        away_team_id,
                        home_score,
                        away_score,
                        status,
                        minute

                    FROM matches

                    WHERE id = ?
                    `,
                    [id]
                );


            if (matches.length === 0) {

                return res.status(404).json({
                    success: false,
                    message:
                        "Match not found"
                });

            }


            const match =
                matches[0];


            /* -----------------------------------------
               CHECK MATCH STATUS
            ----------------------------------------- */

            if (
                match.status !== "live" &&
                match.status !== "half-time"
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Events can only be added while the match is live or at half-time"
                });

            }


            /* -----------------------------------------
               TEAM CHECK
            ----------------------------------------- */

            const numericTeamId =
                Number(team_id);


            const isHomeTeam =
                numericTeamId ===
                Number(
                    match.home_team_id
                );


            const isAwayTeam =
                numericTeamId ===
                Number(
                    match.away_team_id
                );


            if (
                !isHomeTeam &&
                !isAwayTeam
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Selected team does not belong to this match"
                });

            }


            /* -----------------------------------------
               DATABASE CONNECTION
            ----------------------------------------- */

            connection =
                await db.getConnection();


            await connection.beginTransaction();


            /* -----------------------------------------
               INSERT EVENT
            ----------------------------------------- */

            const [eventResult] =
                await connection.query(
                    `
                    INSERT INTO match_events
                    (
                        match_id,
                        team_id,
                        player_name,
                        event_type,
                        minute
                    )
                    VALUES
                    (?, ?, ?, ?, ?)
                    `,
                    [
                        Number(id),
                        numericTeamId,
                        player_name.trim(),
                        event_type,
                        eventMinute
                    ]
                );


            /* -----------------------------------------
               CURRENT SCORE
            ----------------------------------------- */

            let newHomeScore =
                Number(
                    match.home_score || 0
                );


            let newAwayScore =
                Number(
                    match.away_score || 0
                );


            /* -----------------------------------------
               GOAL
            ----------------------------------------- */

            if (
                event_type === "goal"
            ) {

                if (isHomeTeam) {

                    newHomeScore++;

                } else {

                    newAwayScore++;

                }


                await connection.query(
                    `
                    UPDATE matches
                    SET
                        home_score = ?,
                        away_score = ?
                    WHERE id = ?
                    `,
                    [
                        newHomeScore,
                        newAwayScore,
                        id
                    ]
                );

            }


            /* -----------------------------------------
               COMMIT
            ----------------------------------------- */

            await connection.commit();


            /* -----------------------------------------
               GET CREATED EVENT
            ----------------------------------------- */

            const [createdEvents] =
                await db.query(
                    `
                    SELECT
                        id,
                        match_id,
                        team_id,
                        player_name,
                        event_type,
                        minute,
                        created_at

                    FROM match_events

                    WHERE id = ?
                    `,
                    [
                        eventResult.insertId
                    ]
                );


            const createdEvent =
                createdEvents[0];


            /* -----------------------------------------
               SOCKET EVENT
            ----------------------------------------- */

            io.emit(
                "matchEvent",
                {
                    matchId:
                        Number(id),

                    event:
                        createdEvent,

                    home_score:
                        newHomeScore,

                    away_score:
                        newAwayScore
                }
            );


            /* -----------------------------------------
               MATCH UPDATE SOCKET
            ----------------------------------------- */

            io.emit(
                "matchUpdated",
                {
                    matchId:
                        Number(id),

                    status:
                        match.status,

                    minute:
                        match.minute,

                    home_score:
                        newHomeScore,

                    away_score:
                        newAwayScore
                }
            );


            /* -----------------------------------------
               RESPONSE
            ----------------------------------------- */

            res.json({
                success: true,
                message:
                    "Match event added successfully",

                event:
                    createdEvent,

                home_score:
                    newHomeScore,

                away_score:
                    newAwayScore
            });


        } catch (error) {

            if (connection) {

                try {

                    await connection.rollback();

                } catch (rollbackError) {

                    console.error(
                        "Rollback error:",
                        rollbackError
                    );

                }

            }


            console.error(
                "Add match event error:",
                error
            );


            res.status(500).json({
                success: false,
                message:
                    error.sqlMessage ||
                    "Database error while adding match event"
            });


        } finally {

            if (connection) {

                connection.release();

            }

        }

    }
);


