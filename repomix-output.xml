    const [matchDate, setMatchDate] = useState("");
    const [venue, setVenue] = useState("");

    const [creating, setCreating] = useState(false);


    // ==================================================
    // CHECK ADMIN LOGIN
    // ==================================================

    useEffect(() => {

        const token = localStorage.getItem("adminToken");

        if (!token) {
            navigate("/admin/login");
            return;
        }

        fetchTeams();
        fetchFixtures();

    }, [navigate]);


    // ==================================================
    // FETCH TEAMS
    // ==================================================

    async function fetchTeams() {

        try {

            setLoading(true);

            const response = await axios.get(
                "http://localhost:5000/api/teams"
            );

            setTeams(response.data.teams || []);

        } catch (error) {

            console.error("Error loading teams:", error);

            setError("Unable to load teams.");

        } finally {

            setLoading(false);

        }
    }


    // ==================================================
    // FETCH FIXTURES
    // ==================================================

    async function fetchFixtures() {

        try {

            setLoadingFixtures(true);

            const token = localStorage.getItem("adminToken");

            const response = await axios.get(
                "http://localhost:5000/api/admin/matches",
                {
                    headers: {
                        Authorization: `Bearer ${token}`
                    }
                }
            );

            setFixtures(response.data.matches || []);

        } catch (error) {

            console.error("Error loading fixtures:", error);

            if (error.response?.status === 401) {

                localStorage.removeItem("adminToken");
                localStorage.removeItem("admin");

                navigate("/admin/login");

                return;
            }

            setError(
                error.response?.data?.message ||
                "Unable to load fixtures."
            );

        } finally {

            setLoadingFixtures(false);

        }
    }


    // ==================================================
    // CREATE FIXTURE
    // ==================================================

    async function handleCreateFixture(event) {

        event.preventDefault();

        setError("");
        setSuccess("");

        if (!homeTeam || !awayTeam || !matchDate) {

            setError(
                "Please select both teams and a match date."
            );

            return;
        }


        if (homeTeam === awayTeam) {

            setError(
                "Home team and away team cannot be the same."
            );

            return;
        }


        setCreating(true);


        try {

            const token = localStorage.getItem("adminToken");


            const response = await axios.post(
                "http://localhost:5000/api/admin/matches",
                {
                    home_team_id: Number(homeTeam),
                    away_team_id: Number(awayTeam),
                    match_date: matchDate,
                    venue: venue
                },
                {
                    headers: {
                        Authorization: `Bearer ${token}`,
                        "Content-Type": "application/json"
                    }
                }
            );


            if (response.data.success) {

                setSuccess(
                    "Fixture created successfully."
                );

                setHomeTeam("");
                setAwayTeam("");
                setMatchDate("");
                setVenue("");

                setShowForm(false);

                await fetchFixtures();

            }

        } catch (error) {

            console.error(
                "Create fixture error:",
                error
            );


            if (error.response?.status === 401) {

                localStorage.removeItem("adminToken");
                localStorage.removeItem("admin");

                navigate("/admin/login");

                return;
            }


            setError(
                error.response?.data?.message ||
                "Unable to create fixture."
            );

        } finally {

            setCreating(false);

        }
    }


    // ==================================================
    // DELETE FIXTURE
    // ==================================================

    async function handleDeleteFixture(fixture) {

        const confirmed = window.confirm(
            `Are you sure you want to delete the fixture "${fixture.home_team_name} vs ${fixture.away_team_name}"?`
        );


        if (!confirmed) {
            return;
        }


        setError("");
        setSuccess("");


        try {

            const token = localStorage.getItem("adminToken");


            const response = await axios.delete(
                `http://localhost:5000/api/admin/matches/${fixture.id}`,
                {
                    headers: {
                        Authorization: `Bearer ${token}`
                    }
                }
            );


            if (response.data.success) {

                setSuccess(
                    "Fixture deleted successfully."
                );

                await fetchFixtures();

            }

        } catch (error) {

            console.error(
                "Delete fixture error:",
                error
            );


            if (error.response?.status === 401) {

                localStorage.removeItem("adminToken");
                localStorage.removeItem("admin");

                navigate("/admin/login");

                return;
            }


            setError(
                error.response?.data?.message ||
                "Unable to delete fixture."
            );
        }
    }


    // ==================================================
    // FORMAT DATE
    // ==================================================

    function formatDate(dateString) {

        if (!dateString) {
            return "-";
        }


        const date = new Date(dateString);


        return date.toLocaleString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            }
        );
    }


    // ==================================================
    // LOGOUT
    // ==================================================

    function handleLogout() {

        localStorage.removeItem("adminToken");
        localStorage.removeItem("admin");

        navigate("/admin/login");
    }


    // ==================================================
    // RENDER
    // ==================================================

    return (

        <div className="admin-layout">

            {/* SIDEBAR */}

            <aside className="admin-sidebar">

                <div className="admin-sidebar-logo">

                    ⚽ Kocheri Super League

                    <span>
                        ADMIN
                    </span>

                </div>


                <nav className="admin-sidebar-nav">

                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate("/admin/dashboard")
                        }
                    >
                        🏠 Dashboard
                    </button>


                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate("/admin/teams")
                        }
                    >
                        ⚽ Teams
                    </button>


                    <button
                        className="admin-nav-item active"
                        onClick={() =>
                            navigate("/admin/fixtures")
                        }
                    >
                        📅 Fixtures
                    </button>


                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate("/admin/matches")
                        }
                    >
                        🔴 Matches
                    </button>


                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate("/admin/results")
                        }
                    >
                        🏆 Results
                    </button>

                </nav>


                <button
                    className="admin-logout-button"
                    onClick={handleLogout}
                >
                    🚪 Logout
                </button>

            </aside>


            {/* MAIN */}

            <main className="admin-main">


                {/* HEADER */}

                <div className="admin-page-header">

                    <div>

                        <h1>
                            Fixtures
                        </h1>

                        <p>
                            Schedule and manage Kocheri Super League fixtures.
                        </p>

                    </div>


                    <button
                        className="admin-primary-button"
                        onClick={() => {

                            setShowForm(!showForm);

                            setError("");
                            setSuccess("");

                        }}
                    >

                        {showForm
                            ? "Cancel"
                            : "+ Add Fixture"}

                    </button>

                </div>


                {/* ERROR */}

                {error && (

                    <div className="admin-error">
                        {error}
                    </div>

                )}


                {/* SUCCESS */}

                {success && (

                    <div
                        style={{
                            background: "#dcfce7",
                            color: "#166534",
                            padding: "14px 18px",
                            borderRadius: "10px",
                            marginBottom: "20px",
                            fontWeight: "600"
                        }}
                    >
                        {success}
                    </div>

                )}


                {/* ADD FIXTURE FORM */}

                {showForm && (

                    <div className="admin-form-card">

                        <h2>
                            Create New Fixture
                        </h2>


                        <form
                            onSubmit={
                                handleCreateFixture
                            }
                        >


                            {/* HOME TEAM */}

                            <div className="form-group">

                                <label>
                                    Home Team
                                </label>


                                <select
                                    value={homeTeam}
                                    onChange={(event) =>
                                        setHomeTeam(
                                            event.target.value
                                        )
                                    }
                                    required
                                >

                                    <option value="">
                                        Select Home Team
                                    </option>


                                    {teams.map((team) => (

                                        <option
                                            key={team.id}
                                            value={team.id}
                                        >
                                            {team.name}
                                            {team.short_name
                                                ? ` (${team.short_name})`
                                                : ""}
                                        </option>

                                    ))}

                                </select>

                            </div>


