app.post(
    "/api/admin/matches",
    authenticateAdmin,
    async (req, res) => {

        try {

            const {
                home_team_id,
                away_team_id,
                match_date,
                venue
            } = req.body;


            if (
                !home_team_id ||
                !away_team_id ||
                !match_date
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Home team, away team and match date are required"
                });

            }


            if (
                Number(home_team_id) ===
                Number(away_team_id)
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Home and away teams must be different"
                });

            }


            const [teams] =
                await db.query(
                    `
                    SELECT id
                    FROM teams
                    WHERE id IN (?, ?)
                    `,
                    [
                        home_team_id,
                        away_team_id
                    ]
                );


            if (teams.length !== 2) {

                return res.status(400).json({
                    success: false,
                    message:
                        "One or both teams do not exist"
                });

            }


            const [result] =
                await db.query(
                    `
                    INSERT INTO matches
                    (
                        home_team_id,
                        away_team_id,
                        home_score,
                        away_score,
                        match_date,
                        status,
                        minute,
                        venue
                    )
                    VALUES
                    (?, ?, 0, 0, ?, 'scheduled', 0, ?)
                    `,
                    [
                        home_team_id,
                        away_team_id,
                        match_date,
                        venue || null
                    ]
                );


            res.json({
                success: true,
                message:
                    "Fixture created successfully",
                matchId:
                    result.insertId
            });

        } catch (error) {

            console.error(
                "Create fixture error:",
                error
            );

            res.status(500).json({
                success: false,
                message:
                    error.sqlMessage ||
                    "Database error"
            });

        }

    }
);


/* =========================================================
   ADMIN DELETE FIXTURE
========================================================= */

app.delete(
    "/api/admin/matches/:id",
    authenticateAdmin,
    async (req, res) => {

        const connection =
            await db.getConnection();

        try {

            const {
                id
            } = req.params;


            await connection.beginTransaction();


            const [matches] =
                await connection.query(
                    `
                    SELECT *
                    FROM matches
                    WHERE id = ?
                    FOR UPDATE
                    `,
                    [id]
                );


            if (matches.length === 0) {

                await connection.rollback();

                return res.status(404).json({
                    success: false,
                    message: "Match not found"
                });

            }


            const match =
                matches[0];


            if (
                match.status !==
                "scheduled"
            ) {

                await connection.rollback();

                return res.status(400).json({
                    success: false,
                    message:
                        "Only scheduled matches can be deleted"
                });

            }


            await connection.query(
                `
                DELETE FROM match_events
                WHERE match_id = ?
                `,
                [id]
            );


            await connection.query(
                `
                DELETE FROM matches
                WHERE id = ?
                `,
                [id]
            );


            await connection.commit();


            res.json({
                success: true,
                message:
                    "Fixture deleted successfully"
            });

        } catch (error) {

            await connection.rollback();

            console.error(
                "Delete fixture error:",
                error
            );

            res.status(500).json({
                success: false,
                message:
