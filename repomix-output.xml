                return res.status(404).json({
                    success: false,
                    message: "Match not found"
                });

            }

            await db.query(
                `UPDATE matches
                 SET status = ?
                 WHERE id = ?`,
                [
                    status,
                    id
                ]
            );

            const [updatedMatches] =
                await db.query(
                    `SELECT *
                     FROM matches
                     WHERE id = ?`,
                    [id]
                );

            const updatedMatch =
