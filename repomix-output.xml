import { useEffect, useState } from "react";
import { useNavigate, useParams } from "react-router-dom";
import axios from "axios";
import socket from "../../socket";

function AdminLiveMatch() {

    const { id } = useParams();
    const navigate = useNavigate();

    const [match, setMatch] = useState(null);
    const [events, setEvents] = useState([]);

    const [loading, setLoading] = useState(true);
    const [actionLoading, setActionLoading] = useState(false);

    const [error, setError] = useState("");
    const [success, setSuccess] = useState("");

    const [playerName, setPlayerName] = useState("");
    const [eventType, setEventType] = useState("goal");
    const [eventTeam, setEventTeam] = useState("");
    const [eventMinute, setEventMinute] = useState(1);


    /* =====================================================
       FETCH MATCH
    ===================================================== */

    async function fetchMatch() {

        try {

            setLoading(true);
            setError("");

            const token =
                localStorage.getItem("adminToken");

            if (!token) {
                navigate("/admin/login");
                return;
            }

            const response = await axios.get(
                `http://localhost:5000/api/admin/matches/${id}`,
                {
                    headers: {
                        Authorization:
                            `Bearer ${token}`
                    }
                }
            );

            if (response.data.success) {

                const loadedMatch =
                    response.data.match;

                setMatch(loadedMatch);

                setEvents(
                    response.data.events || []
                );

                setEventMinute(
                    loadedMatch.minute || 1
                );

                if (!eventTeam) {

                    setEventTeam(
                        String(
                            loadedMatch.home_team_id
                        )
                    );
                }
            }

        } catch (error) {

            console.error(
                "Load live match error:",
                error
            );

            if (
                error.response?.status === 401
            ) {

                localStorage.removeItem(
                    "adminToken"
                );

                localStorage.removeItem(
                    "admin"
                );

                navigate("/admin/login");
                return;
            }

            setError(
                error.response?.data?.message ||
                "Unable to load match."
            );

        } finally {

            setLoading(false);

        }
    }


    /* =====================================================
       INITIAL LOAD
    ===================================================== */

    useEffect(() => {

        fetchMatch();

    }, [id]);


    /* =====================================================
       CLEAR MESSAGES
    ===================================================== */

    function clearMessages() {

        setError("");
        setSuccess("");

    }


    /* =====================================================
       GENERIC ACTION
    ===================================================== */

    async function performAction(
        requestFunction,
        successMessage
    ) {

        try {

            setActionLoading(true);
            clearMessages();

            const response =
                await requestFunction();

            if (response.data.success) {

                setSuccess(
                    successMessage ||
                    response.data.message
                );

                await fetchMatch();

            }

        } catch (error) {

            console.error(
                "Match action error:",
                error
            );

            if (
                error.response?.status === 401
            ) {

                localStorage.removeItem(
                    "adminToken"
                );

                localStorage.removeItem(
                    "admin"
                );

                navigate("/admin/login");

                return;
            }

            setError(
                error.response?.data?.message ||
                "Action failed."
            );

        } finally {

            setActionLoading(false);

        }
    }


    /* =====================================================
       START MATCH
    ===================================================== */

    async function handleStartMatch() {

        const token =
            localStorage.getItem("adminToken");

        await performAction(
            () =>
                axios.put(
                    `http://localhost:5000/api/admin/matches/${id}/start`,
                    {},
                    {
                        headers: {
                            Authorization:
                                `Bearer ${token}`
                        }
                    }
                ),
            "Match started successfully."
        );
    }


    /* =====================================================
       UPDATE STATUS
    ===================================================== */

    async function handleStatusChange(status) {

        const token =
            localStorage.getItem("adminToken");

        await performAction(
            () =>
                axios.put(
                    `http://localhost:5000/api/admin/matches/${id}/status`,
                    {
                        status
                    },
                    {
                        headers: {
                            Authorization:
                                `Bearer ${token}`
                        }
                    }
                ),
            `Match status changed to ${status}.`
        );
    }


    /* =====================================================
       UPDATE MINUTE
    ===================================================== */

    async function updateMinute(newMinute) {

        if (!match) {
            return;
        }

        const safeMinute = Math.max(
            0,
            Math.min(130, newMinute)
        );

        const token =
            localStorage.getItem("adminToken");

        await performAction(
            () =>
                axios.put(
                    `http://localhost:5000/api/admin/matches/${id}/minute`,
                    {
                        minute: safeMinute
                    },
                    {
                        headers: {
                            Authorization:
                                `Bearer ${token}`
                        }
                    }
                ),
            `Match minute updated to ${safeMinute}'.`
        );
    }


    /* =====================================================
       ADD EVENT
    ===================================================== */

    async function handleAddEvent(event) {

        event.preventDefault();

        if (!match) {
            return;
        }

        if (!playerName.trim()) {

            setError(
                "Please enter the player name."
            );

            return;
        }

        if (!eventTeam) {

            setError(
                "Please select a team."
            );

            return;
        }

        const numericMinute =
            Number(eventMinute);

        if (
            !Number.isInteger(
                numericMinute
            ) ||
            numericMinute < 0 ||
            numericMinute > 130
        ) {

            setError(
                "Minute must be between 0 and 130."
            );

            return;
        }

        const token =
            localStorage.getItem("adminToken");

        await performAction(
            () =>
                axios.post(
                    `http://localhost:5000/api/admin/matches/${id}/events`,
                    {
                        team_id:
                            Number(eventTeam),

                        player_name:
                            playerName.trim(),

                        event_type:
                            eventType,

                        minute:
                            numericMinute
                    },
                    {
                        headers: {
                            Authorization:
                                `Bearer ${token}`
                        }
                    }
                ),
            "Match event added successfully."
        );

        setPlayerName("");

        setEventMinute(
            match.minute || 1
        );

    }


    /* =====================================================
       FINISH MATCH
    ===================================================== */

    async function handleFinishMatch() {

        const confirmed =
            window.confirm(
                "Are you sure you want to finish this match?"
            );

        if (!confirmed) {
            return;
        }

        const token =
            localStorage.getItem("adminToken");

        await performAction(
            () =>
                axios.put(
                    `http://localhost:5000/api/admin/matches/${id}/finish`,
                    {},
                    {
                        headers: {
                            Authorization:
                                `Bearer ${token}`
                        }
                    }
                ),
            "Match finished successfully."
        );
    }


    /* =====================================================
       LOGOUT
    ===================================================== */

    function handleLogout() {

        localStorage.removeItem(
            "adminToken"
        );

        localStorage.removeItem(
            "admin"
        );

        navigate("/admin/login");

    }


    /* =====================================================
       LOADING
    ===================================================== */

    if (loading) {

        return (
            <div className="admin-layout">

                <aside className="admin-sidebar">

                    <div className="admin-sidebar-logo">
    <img
        src="/logo.png"
        alt="Kocheri Super League"
    />

    <strong>Kocheri Super League</strong>

    <span>ADMIN</span>
</div>

                </aside>

                <main className="admin-main">

                    <div className="admin-message">
                        Loading match...
                    </div>

                </main>

            </div>
        );
    }


    /* =====================================================
       MATCH NOT FOUND
    ===================================================== */

    if (!match) {

        return (
            <div className="admin-layout">

                <aside className="admin-sidebar">

                    <div className="admin-sidebar-logo">
                        ⚽ Kocheri Super League
                        <span>ADMIN</span>
                    </div>

                </aside>

                <main className="admin-main">

                    <div className="admin-error">
                        {error ||
                            "Match not found."}
                    </div>

                    <button
                        className="admin-primary-button"
                        onClick={() =>
                            navigate(
                                "/admin/fixtures"
                            )
                        }
                    >
                        Back to Fixtures
                    </button>

                </main>

            </div>
        );
    }


    /* =====================================================
       STATUS HELPERS
    ===================================================== */

    const isScheduled =
        match.status === "scheduled";

    const isLive =
        match.status === "live";

    const isHalfTime =
        match.status === "half-time";

    const isFinished =
        match.status === "finished";


    /* =====================================================
       RENDER
    ===================================================== */

    return (

        <div className="admin-layout">

            {/* =============================================
                SIDEBAR
            ============================================= */}

            <aside className="admin-sidebar">

                <div className="admin-sidebar-logo">
                    ⚽ Kocheri Super League
                    <span>ADMIN</span>
                </div>

                <nav className="admin-sidebar-nav">

                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate(
                                "/admin/dashboard"
                            )
                        }
                    >
                        🏠 Dashboard
                    </button>

                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate(
                                "/admin/teams"
                            )
                        }
                    >
                        ⚽ Teams
                    </button>

                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate(
                                "/admin/fixtures"
                            )
                        }
                    >
                        📅 Fixtures
                    </button>

                    <button
                        className="admin-nav-item active"
                        onClick={() =>
                            navigate(
                                `/admin/live-match/${id}`
                            )
                        }
                    >
                        🔴 Live Match
                    </button>

                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate(
                                "/admin/results"
