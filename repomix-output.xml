/* =========================================================
   ADMIN UPDATE TEAM
========================================================= */

app.put(
    "/api/admin/teams/:id",
    authenticateAdmin,
    uploadTeamLogo.single("logo"),
    async (req, res) => {

        try {

            const {
                id
            } = req.params;

            const {
                name,
                short_name
            } = req.body;


            const [teams] =
                await db.query(
                    `
                    SELECT *
                    FROM teams
                    WHERE id = ?
                    `,
                    [id]
                );


            if (teams.length === 0) {

                return res.status(404).json({
                    success: false,
                    message: "Team not found"
                });

            }


            const team =
                teams[0];


            const newName =
                name !== undefined
                    ? name.trim()
                    : team.name;


            const newShortName =
                short_name !== undefined
                    ? short_name.trim()
                    : team.short_name;


            let newLogo =
                team.logo;


            if (req.file) {

                newLogo =
                    `/uploads/team-logos/${req.file.filename}`;


                /* Delete old logo */

                if (team.logo) {

                    const oldLogoPath =
                        path.join(
                            __dirname,
                            team.logo.replace(
                                "/uploads/",
                                "uploads/"
                            )
                        );


                    if (
                        fs.existsSync(
                            oldLogoPath
                        )
                    ) {

                        try {

                            fs.unlinkSync(
                                oldLogoPath
                            );

                        } catch (deleteError) {

                            console.error(
                                "Old logo delete error:",
                                deleteError
                            );

                        }

                    }

                }

            }


            await db.query(
                `
                UPDATE teams
                SET
                    name = ?,
                    short_name = ?,
                    logo = ?
                WHERE id = ?
                `,
                [
                    newName,
                    newShortName,
                    newLogo,
                    id
                ]
            );


            res.json({
                success: true,
                message:
                    "Team updated successfully"
            });

        } catch (error) {

            console.error(
                "Update team error:",
                error
            );

            res.status(500).json({
                success: false,
                message:
                    error.sqlMessage ||
                    "Database error"
            });

        }

    }
);


