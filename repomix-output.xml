import { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import axios from "axios";

function AdminTeams() {

    const navigate = useNavigate();

    const [teams, setTeams] = useState([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState("");

    /* =====================================================
       ADD TEAM
    ===================================================== */

    const [showAddForm, setShowAddForm] =
        useState(false);

    const [teamName, setTeamName] =
        useState("");

    const [shortName, setShortName] =
        useState("");

    const [teamLogo, setTeamLogo] =
        useState(null);

    const [logoPreview, setLogoPreview] =
        useState("");

    const [adding, setAdding] =
        useState(false);

    /* =====================================================
       EDIT TEAM
    ===================================================== */

    const [editingTeam, setEditingTeam] =
        useState(null);

    const [editTeamName, setEditTeamName] =
        useState("");

    const [editShortName, setEditShortName] =
        useState("");

    const [editTeamLogo, setEditTeamLogo] =
        useState(null);

    const [editLogoPreview, setEditLogoPreview] =
        useState("");

    const [updating, setUpdating] =
        useState(false);

    /* =====================================================
       INITIAL LOAD
    ===================================================== */

    useEffect(() => {

        const token =
            localStorage.getItem("adminToken");

        if (!token) {

            navigate("/admin/login");

            return;

        }

        fetchTeams();

    }, [navigate]);

    /* =====================================================
       FETCH TEAMS
    ===================================================== */

    async function fetchTeams() {

        try {

            setLoading(true);
            setError("");

            const response =
                await axios.get(
                    "http://localhost:5000/api/teams"
                );

            setTeams(
                response.data.teams || []
            );

        } catch (error) {

            console.error(
                "Error loading teams:",
                error
            );

            setError(
                "Unable to load teams."
            );

        } finally {

            setLoading(false);

        }

    }

    /* =====================================================
       ADD LOGO
    ===================================================== */

    function handleLogoChange(event) {

        const file =
            event.target.files[0];

        if (!file) {

            return;

        }

        setTeamLogo(file);

        const preview =
            URL.createObjectURL(file);

        setLogoPreview(preview);

    }

    /* =====================================================
       EDIT LOGO
    ===================================================== */

    function handleEditLogoChange(event) {

        const file =
            event.target.files[0];

        if (!file) {

            return;

        }

        setEditTeamLogo(file);

        const preview =
            URL.createObjectURL(file);

        setEditLogoPreview(preview);

    }

    /* =====================================================
       ADD TEAM
    ===================================================== */

    async function handleAddTeam(event) {

        event.preventDefault();

        setError("");
        setAdding(true);

        try {

            const token =
                localStorage.getItem(
                    "adminToken"
                );

            const formData =
                new FormData();

            formData.append(
                "name",
                teamName
            );

            formData.append(
                "short_name",
                shortName
            );

            if (teamLogo) {

                formData.append(
                    "logo",
                    teamLogo
                );

            }

            const response =
                await axios.post(
                    "http://localhost:5000/api/admin/teams",
                    formData,
                    {
                        headers: {
                            Authorization:
                                `Bearer ${token}`
                        }
                    }
                );

            if (response.data.success) {

                setTeamName("");
                setShortName("");
                setTeamLogo(null);
                setLogoPreview("");
                setShowAddForm(false);

                await fetchTeams();

            }

        } catch (error) {

            console.error(
                "Add team error:",
                error
            );

            if (
                error.response?.status === 401
            ) {

                localStorage.removeItem(
                    "adminToken"
                );

                localStorage.removeItem(
                    "admin"
                );

                navigate("/admin/login");

                return;

            }

            setError(
                error.response?.data?.message ||
                "Unable to add team."
            );

        } finally {

            setAdding(false);

        }

    }

    /* =====================================================
       START EDITING
    ===================================================== */

    function startEditing(team) {

        setEditingTeam(team);

        setEditTeamName(
            team.name
        );

        setEditShortName(
            team.short_name || ""
        );

        setEditTeamLogo(null);

        if (team.logo) {

            setEditLogoPreview(
                `http://localhost:5000${team.logo}`
            );

        } else {

            setEditLogoPreview("");

        }

        setShowAddForm(false);
        setError("");

    }

    /* =====================================================
       CANCEL EDIT
    ===================================================== */

    function cancelEditing() {

        setEditingTeam(null);

        setEditTeamName("");
        setEditShortName("");
        setEditTeamLogo(null);
        setEditLogoPreview("");

    }

    /* =====================================================
       UPDATE TEAM
    ===================================================== */

    async function handleEditTeam(event) {

        event.preventDefault();

        if (!editingTeam) {

            return;

        }

        setError("");
        setUpdating(true);

        try {

            const token =
                localStorage.getItem(
                    "adminToken"
                );

            const formData =
                new FormData();

            formData.append(
                "name",
                editTeamName
            );

            formData.append(
                "short_name",
                editShortName
            );

            if (editTeamLogo) {

                formData.append(
                    "logo",
                    editTeamLogo
                );

            }

            const response =
                await axios.put(
                    `http://localhost:5000/api/admin/teams/${editingTeam.id}`,
                    formData,
                    {
                        headers: {
                            Authorization:
                                `Bearer ${token}`
                        }
                    }
                );

            if (response.data.success) {

                cancelEditing();

                await fetchTeams();

            }

        } catch (error) {

            console.error(
                "Update team error:",
                error
            );

            if (
                error.response?.status === 401
            ) {

                localStorage.removeItem(
                    "adminToken"
                );

                localStorage.removeItem(
                    "admin"
                );

                navigate("/admin/login");

                return;

            }

            setError(
                error.response?.data?.message ||
                "Unable to update team."
            );

        } finally {

            setUpdating(false);

        }

    }

    /* =====================================================
       DELETE TEAM
    ===================================================== */

    async function handleDeleteTeam(team) {

        const confirmed =
            window.confirm(
                `Are you sure you want to delete "${team.name}"?`
            );

        if (!confirmed) {

            return;

        }

        setError("");

        try {

            const token =
                localStorage.getItem(
                    "adminToken"
                );

            const response =
                await axios.delete(
                    `http://localhost:5000/api/admin/teams/${team.id}`,
                    {
                        headers: {
                            Authorization:
                                `Bearer ${token}`
                        }
                    }
                );

            if (response.data.success) {

                await fetchTeams();

            }

        } catch (error) {

            console.error(
                "Delete team error:",
                error
            );

            if (
                error.response?.status === 401
            ) {

                localStorage.removeItem(
                    "adminToken"
                );

                localStorage.removeItem(
                    "admin"
                );

                navigate("/admin/login");

                return;

            }

            setError(
                error.response?.data?.message ||
                "Unable to delete team."
            );

        }

    }

    /* =====================================================
       LOGOUT
    ===================================================== */

    function handleLogout() {

        localStorage.removeItem(
            "adminToken"
        );

        localStorage.removeItem(
            "admin"
        );

        navigate("/admin/login");

    }

    /* =====================================================
       RENDER
    ===================================================== */

    return (

        <div className="admin-layout">

            {/* SIDEBAR */}

            <aside className="admin-sidebar">

                <div className="admin-sidebar-logo">

                    ⚽ Kocheri Super League

                    <span>
                        ADMIN
                    </span>

                </div>

                <nav className="admin-sidebar-nav">

                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate(
                                "/admin/dashboard"
                            )
                        }
                    >
                        🏠 Dashboard
                    </button>

                    <button
                        className="admin-nav-item active"
                        onClick={() =>
                            navigate(
                                "/admin/teams"
                            )
                        }
                    >
                        ⚽ Teams
                    </button>

                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate(
                                "/admin/fixtures"
                            )
                        }
                    >
                        📅 Fixtures
                    </button>

                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate(
                                "/admin/matches"
                            )
                        }
                    >
                        🔴 Matches
                    </button>

                    <button
                        className="admin-nav-item"
                        onClick={() =>
                            navigate(
                                "/admin/results"
                            )
                        }
                    >
                        🏆 Results
                    </button>

                </nav>

                <button
                    className="admin-logout-button"
                    onClick={handleLogout}
                >
                    🚪 Logout
                </button>

            </aside>

            {/* MAIN */}

            <main className="admin-main">

                {/* HEADER */}

                <div className="admin-page-header">

                    <div>

                        <h1>
                            Teams
                        </h1>

                        <p>
                            Manage Kocheri Super League teams.
                        </p>

                    </div>

                    <button
                        className="admin-primary-button"
                        onClick={() => {

                            setShowAddForm(
                                !showAddForm
                            );

                            if (editingTeam) {

                                cancelEditing();

                            }

                        }}
                    >

                        {showAddForm
                            ? "Cancel"
                            : "+ Add Team"}

                    </button>

                </div>

                {/* ERROR */}

                {error && (

                    <div className="admin-error">

                        {error}

                    </div>

                )}

                {/* ADD FORM */}

                {showAddForm && (

                    <div className="admin-form-card">

                        <h2>
                            Add New Team
                        </h2>

                        <form
                            onSubmit={
                                handleAddTeam
                            }
                        >

                            <div className="form-group">

                                <label>
                                    Team Name
                                </label>

                                <input
                                    type="text"
                                    value={
                                        teamName
                                    }
                                    onChange={
                                        (event) =>
                                            setTeamName(
                                                event.target.value
                                            )
                                    }
                                    placeholder="Example: GOATZ"
                                    required
                                />

                            </div>

                            <div className="form-group">

                                <label>
                                    Short Name
                                </label>

                                <input
                                    type="text"
                                    value={
                                        shortName
                                    }
                                    onChange={
                                        (event) =>
                                            setShortName(
                                                event.target.value
                                            )
                                    }
                                    placeholder="Example: GTZ"
                                    required
                                />

                            </div>

                            <div className="form-group">

                                <label>
                                    Team Logo
                                </label>

                                <input
                                    type="file"
                                    accept="image/png,image/jpeg,image/webp,image/svg+xml"
                                    onChange={
                                        handleLogoChange
                                    }
                                />

                            </div>

                            {logoPreview && (

                                <div
                                    style={{
                                        marginBottom:
                                            "20px"
                                    }}
                                >

                                    <p>
                                        Logo Preview
                                    </p>

                                    <img
                                        src={
                                            logoPreview
                                        }
                                        alt="Logo preview"
                                        style={{
                                            width:
                                                "100px",
                                            height:
                                                "100px",
                                            objectFit:
                                                "contain",
                                            borderRadius:
                                                "12px",
                                            border:
                                                "1px solid #ddd"
                                        }}
