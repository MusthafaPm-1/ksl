                                                <strong
                                                    style={{
                                                        minWidth:
                                                            "45px"
                                                    }}
                                                >
                                                    {event.minute}'
                                                </strong>

                                                <span
                                                    style={{
                                                        fontSize:
                                                            "22px"
                                                    }}
