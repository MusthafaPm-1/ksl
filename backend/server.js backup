            if (req.file) {

                const logoPath =
                    "/uploads/team-logos/" +
                    req.file.filename;

                await db.query(
                    `UPDATE teams
                     SET
                        name = ?,
                        short_name = ?,
                        logo = ?
                     WHERE id = ?`,
                    [
                        name,
                        short_name,
                        logoPath,
                        id
                    ]
                );

            } else {

                await db.query(
                    `UPDATE teams
                     SET
                        name = ?,
                        short_name = ?
                     WHERE id = ?`,
                    [
                        name,
                        short_name,
                        id
                    ]
                );

            }

            res.json({

                success: true,

                message:
                    "Team updated successfully"

            });

