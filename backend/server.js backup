   ADD MATCH EVENT
========================================================= */

app.post(
    "/api/admin/matches/:id/events",
    authenticateAdmin,
    async (req, res) => {

        const connection =
            await db.getConnection();

        try {

            const { id } = req.params;

            const {
                team_id,
                player_name,
                event_type,
                minute
            } = req.body || {};

            const allowedEvents = [
                "goal",
                "yellow_card",
                "red_card",
                "substitution"
            ];

            if (
                !allowedEvents.includes(
                    event_type
                )
            ) {

                connection.release();

                return res.status(400).json({
                    success: false,
                    message:
                        "Invalid event type"
                });

            }

            const numericMinute =
                Number(minute);

            if (
                !Number.isInteger(
                    numericMinute
                ) ||
                numericMinute < 0 ||
                numericMinute > 130
            ) {

                connection.release();

                return res.status(400).json({
                    success: false,
                    message:
                        "Invalid match minute"
                });

            }

            await connection.beginTransaction();

            /* -----------------------------------------
               CHECK MATCH
            ----------------------------------------- */

            const [matches] =
                await connection.query(
                    `SELECT *
                     FROM matches
                     WHERE id = ?
                     FOR UPDATE`,
                    [id]
                );

            if (
                matches.length === 0
            ) {

                await connection.rollback();
                connection.release();

                return res.status(404).json({
                    success: false,
                    message:
                        "Match not found"
                });

            }

            const match =
                matches[0];

            /* -----------------------------------------
               CHECK TEAM
            ----------------------------------------- */

            if (
                event_type === "goal" ||
                event_type === "yellow_card" ||
                event_type === "red_card" ||
                event_type === "substitution"
            ) {

                if (!team_id) {

                    await connection.rollback();
                    connection.release();

                    return res.status(400).json({
                        success: false,
                        message:
                            "Team is required for this event"
                    });

                }

                const numericTeamId =
                    Number(team_id);

                if (
                    numericTeamId !==
                    Number(match.home_team_id) &&
                    numericTeamId !==
                    Number(match.away_team_id)
                ) {

                    await connection.rollback();
                    connection.release();

                    return res.status(400).json({
                        success: false,
                        message:
                            "Team is not part of this match"
                    });

                }

            }

            /* -----------------------------------------
               PLAYER NAME
            ----------------------------------------- */

            if (
                !player_name ||
                !player_name.trim()
            ) {

                await connection.rollback();
                connection.release();

                return res.status(400).json({
                    success: false,
                    message:
                        "Player name is required"
                });

            }

            /* -----------------------------------------
               MATCH STATUS CHECK
            ----------------------------------------- */

            if (
                match.status !== "live" &&
                match.status !== "half-time"
            ) {

                await connection.rollback();
                connection.release();

                return res.status(400).json({
                    success: false,
                    message:
                        "Events can only be added to a live or half-time match"
                });

            }

            /* -----------------------------------------
               INSERT EVENT
            ----------------------------------------- */

            const [eventResult] =
                await connection.query(
                    `INSERT INTO match_events
                    (
                        match_id,
                        team_id,
                        player_name,
                        event_type,
                        minute
                    )
                    VALUES (?, ?, ?, ?, ?)`,
                    [
                        id,
                        team_id || null,
                        player_name.trim(),
                        event_type,
                        numericMinute
                    ]
                );

            /* -----------------------------------------
               GOAL → UPDATE SCORE
            ----------------------------------------- */

            if (
                event_type === "goal"
            ) {

                if (
                    Number(team_id) ===
                    Number(match.home_team_id)
                ) {

                    await connection.query(
                        `UPDATE matches
                         SET home_score =
                             home_score + 1
                         WHERE id = ?`,
                        [id]
                    );

                } else if (
                    Number(team_id) ===
                    Number(match.away_team_id)
                ) {

                    await connection.query(
                        `UPDATE matches
                         SET away_score =
                             away_score + 1
                         WHERE id = ?`,
                        [id]
                    );

                }

            }

            await connection.commit();

            connection.release();

            /* -----------------------------------------
               GET UPDATED MATCH
            ----------------------------------------- */

            const [updatedMatches] =
                await db.query(
                    `SELECT *
                     FROM matches
                     WHERE id = ?`,
                    [id]
                );

            const updatedMatch =
                updatedMatches[0];

            /* -----------------------------------------
               GET EVENT
            ----------------------------------------- */

            const [events] =
                await db.query(
                    `SELECT *
                     FROM match_events
                     WHERE id = ?`,
                    [eventResult.insertId]
                );

            const createdEvent =
                events[0];

            /* -----------------------------------------
               SOCKET.IO
            ----------------------------------------- */

            io.emit(
                "match_event",
                {
                    match:
                        updatedMatch,
                    event:
                        createdEvent
                }
            );

            io.emit(
                "match_updated",
                updatedMatch
            );

            res.status(201).json({
                success: true,
                message:
                    "Match event added successfully",
                match:
                    updatedMatch,
                event:
                    createdEvent
            });

        } catch (error) {

            try {
                await connection.rollback();
            } catch (rollbackError) {
                console.error(
                    "Rollback error:",
                    rollbackError
                );
            }

            connection.release();

            console.error(
                "ADD MATCH EVENT ERROR:",
                error
            );

            res.status(500).json({
                success: false,
                message:
                    error.message ||
                    "Database error"
            });

        }

    }
);


