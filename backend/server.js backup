                        me.match_id,
                        me.team_id,
                        me.player_name,
                        me.event_type,
                        me.minute,
                        me.created_at,

                        t.name AS team_name,
                        t.logo AS team_logo

                    FROM match_events me

                    LEFT JOIN teams t
                        ON me.team_id = t.id

                    WHERE me.id = ?
                    `,
                    [eventResult.insertId]
                );


            const createdEvent =
                createdEvents[0];


            // ----------------------------------------
            // SOCKET.IO - EVENT
            // ----------------------------------------

            io.emit("matchEvent", {
                matchId: Number(id),
                event: createdEvent
            });


            // ----------------------------------------
            // SOCKET.IO - UPDATED SCORE
            // ----------------------------------------

            io.emit("matchUpdated", {
                matchId: Number(id),

                status: match.status,

                minute: Number(match.minute || 0),

                home_score: newHomeScore,

                away_score: newAwayScore
            });


            res.json({
                success: true,

                message:
                    "Match event added successfully",

                event: createdEvent,

                home_score: newHomeScore,

                away_score: newAwayScore
            });

        } catch (error) {

            if (connection) {
                try {
                    await connection.rollback();
                } catch (rollbackError) {
                    console.error(
                        "Rollback error:",
                        rollbackError
                    );
                }
            }

            console.error(
                "Add match event error:",
                error
            );

            res.status(500).json({
                success: false,
                message: "Database error"
            });

        } finally {

            if (connection) {
                connection.release();
            }
        }
    }
);

// ------------------------------------------------------------
// DELETE MATCH EVENT
// ------------------------------------------------------------

app.delete(
    "/api/admin/matches/events/:eventId",
    authenticateAdmin,
    async (req, res) => {
        let connection;

        try {
            const { eventId } = req.params;


            // ----------------------------------------
            // GET EVENT
            // ----------------------------------------

            const [events] = await db.query(
                `
                SELECT
                    me.*,
                    m.home_team_id,
                    m.away_team_id,
                    m.home_score,
                    m.away_score

                FROM match_events me

                INNER JOIN matches m
                    ON me.match_id = m.id

                WHERE me.id = ?
                `,
                [eventId]
            );


            if (events.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Event not found"
                });
            }


            const event = events[0];


            // ----------------------------------------
            // TRANSACTION
            // ----------------------------------------

            connection = await db.getConnection();

            await connection.beginTransaction();


            // ----------------------------------------
            // IF GOAL → DECREASE SCORE
            // ----------------------------------------

            let newHomeScore =
                Number(event.home_score || 0);

            let newAwayScore =
                Number(event.away_score || 0);


            if (event.event_type === "goal") {

                if (
                    Number(event.team_id) ===
                    Number(event.home_team_id)
                ) {
                    newHomeScore =
                        Math.max(
                            0,
                            newHomeScore - 1
                        );
                }


                if (
                    Number(event.team_id) ===
                    Number(event.away_team_id)
                ) {
                    newAwayScore =
                        Math.max(
                            0,
                            newAwayScore - 1
                        );
                }


                await connection.query(
                    `
                    UPDATE matches

                    SET
                        home_score = ?,
                        away_score = ?

                    WHERE id = ?
                    `,
                    [
                        newHomeScore,
                        newAwayScore,
                        event.match_id
                    ]
                );
            }


            // ----------------------------------------
            // DELETE EVENT
            // ----------------------------------------

            await connection.query(
                `
                DELETE FROM match_events
                WHERE id = ?
                `,
                [eventId]
            );


            await connection.commit();


            // ----------------------------------------
            // SOCKET.IO
            // ----------------------------------------

            io.emit("matchEventDeleted", {
                matchId:
                    Number(event.match_id),

                eventId:
                    Number(eventId)
            });


            io.emit("matchUpdated", {
                matchId:
                    Number(event.match_id),

                home_score:
                    newHomeScore,

                away_score:
                    newAwayScore
            });


            res.json({
                success: true,

                message:
                    "Match event deleted successfully",

                home_score:
                    newHomeScore,

                away_score:
                    newAwayScore
            });

        } catch (error) {

            if (connection) {
                try {
                    await connection.rollback();
                } catch (rollbackError) {
                    console.error(
                        "Rollback error:",
                        rollbackError
                    );
                }
            }

            console.error(
                "Delete match event error:",
                error
            );

            res.status(500).json({
                success: false,
                message: "Database error"
            });

        } finally {

            if (connection) {
                connection.release();
            }
        }
    }
);

