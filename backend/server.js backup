// CREATE FIXTURE
app.post(
    "/api/admin/matches",
    authenticateAdmin,
    async (req, res) => {

        try {

            const {
                home_team_id,
                away_team_id,
                match_date,
                venue
            } = req.body;


            // Validate required fields
            if (
                !home_team_id ||
                !away_team_id ||
                !match_date
            ) {
                return res.status(400).json({
                    success: false,
                    message: "Home team, away team and match date are required"
                });
            }


            // Prevent same team
            if (home_team_id === away_team_id) {
                return res.status(400).json({
                    success: false,
                    message: "Home team and away team cannot be the same"
                });
            }


            // Check home team
            const [homeTeam] = await db.query(
                "SELECT id, name FROM teams WHERE id = ?",
                [home_team_id]
            );

            if (homeTeam.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Home team not found"
                });
            }


            // Check away team
            const [awayTeam] = await db.query(
                "SELECT id, name FROM teams WHERE id = ?",
                [away_team_id]
            );

            if (awayTeam.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Away team not found"
                });
            }


            // Create fixture
            const [result] = await db.query(
                `
                INSERT INTO matches
                (
                    home_team_id,
                    away_team_id,
                    home_score,
                    away_score,
                    match_date,
                    status,
                    minute,
                    venue
                )
                VALUES (?, ?, 0, 0, ?, 'scheduled', 0, ?)
                `,
                [
                    home_team_id,
                    away_team_id,
                    match_date,
                    venue || null
                ]
            );


            res.status(201).json({
                success: true,
                message: "Fixture created successfully",
                matchId: result.insertId
            });


        } catch (error) {

            console.error("Create fixture error:", error);

            res.status(500).json({
                success: false,
                message: "Database error"
            });
        }
    }
);


// DELETE FIXTURE
app.delete(
    "/api/admin/matches/:id",
    authenticateAdmin,
    async (req, res) => {

        try {

            const { id } = req.params;


            // Check if match exists
            const [matches] = await db.query(
                "SELECT id, status FROM matches WHERE id = ?",
                [id]
            );


            if (matches.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Match not found"
                });
            }


            // Only allow deletion of scheduled fixtures
            if (matches[0].status !== "scheduled") {
                return res.status(409).json({
                    success: false,
                    message: "Only scheduled fixtures can be deleted"
                });
            }


            // Delete related events first
            await db.query(
                "DELETE FROM match_events WHERE match_id = ?",
                [id]
            );


            // Delete fixture
            await db.query(
                "DELETE FROM matches WHERE id = ?",
                [id]
            );


            res.json({
                success: true,
                message: "Fixture deleted successfully"
            });


        } catch (error) {

            console.error("Delete fixture error:", error);

            res.status(500).json({
                success: false,
                message: "Database error"
            });
        }
    }
);

