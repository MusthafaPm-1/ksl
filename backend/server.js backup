                await db.query(
                    `SELECT *
                     FROM teams
                     WHERE id = ?`,
                    [id]
                );

            if (teamRows.length === 0) {

                return res.status(404).json({

                    success: false,

                    message:
                        "Team not found"

                });

            }

            /* -----------------------------------------
               CHECK DUPLICATES
            ----------------------------------------- */

            const [existingTeams] =
                await db.query(
                    `SELECT id
                     FROM teams
                     WHERE
                        (
                            name = ?
                            OR short_name = ?
                        )
                        AND id != ?`,
                    [
