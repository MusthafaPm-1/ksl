/* =========================================================
   MULTER - TEAM LOGOS
========================================================= */

const logoStorage = multer.diskStorage({

    destination: function (req, file, cb) {

        cb(
            null,
            path.join(
                __dirname,
                "uploads",
                "team-logos"
            )
        );

    },

    filename: function (req, file, cb) {

        const extension =
            path.extname(file.originalname);

        const filename =
            "team-" +
            Date.now() +
            extension;

        cb(null, filename);

    }

});

const uploadTeamLogo = multer({

    storage: logoStorage,

    fileFilter: function (req, file, cb) {

        const allowedTypes = [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/svg+xml"
        ];

        if (
            allowedTypes.includes(
                file.mimetype
            )
        ) {

            cb(null, true);

        } else {

            cb(
                new Error(
                    "Only JPG, PNG, WEBP and SVG images are allowed"
                )
            );

        }

    },

    limits: {
        fileSize: 2 * 1024 * 1024
    }

});

