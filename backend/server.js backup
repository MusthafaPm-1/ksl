                        short_name,
                        id
                    ]
                );

            if (existingTeams.length > 0) {

                return res.status(409).json({

                    success: false,

                    message:
                        "Team name or short name already exists"

                });

            }

            /* -----------------------------------------
               UPDATE WITH OR WITHOUT LOGO
